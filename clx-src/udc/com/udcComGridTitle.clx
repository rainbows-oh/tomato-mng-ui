<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-4804cf3c" version="1.0.5186">
  <head std:sid="head-163d7b52">
    <screen std:sid="screen-403f19a5" id="EXB-FULL" name="EXB-FULL" width="1580px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-8e5a8e07" id="EXB-DIV" name="EXB-DIV" width="1128px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-5b7337d5" id="EXB-PART" name="EXB-PART" width="672px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <cl:model std:sid="model-50c1fade"/>
    <cl:appspec title="그리드 타이틀">
      <cl:property name="ctrl" type="control" std:desc="[Grid] 대상 그리드 객체"/>
      <cl:property name="title" type="string" default="No Title" bindable="true" std:desc="[String] 제목 (default: No Title)&#xD;&#xA;&#xD;&#xA;ctrl 속성이 지정된 경우, ctrl 컨트롤의 fieldLabel 이 title 로 대체됩니다."/>
      <cl:property name="rowCount" type="string" default="0" bindable="true" std:desc="[Number] 그리드 건수 (default: 0)&#xD;&#xA;&#xD;&#xA;ctrl 속성에 그리드 컨트롤이 설정되어 있는 경우, 그리드의 건수로 대체됩니다."/>
      <cl:property name="showExportExcel" type="boolean" default="true" bindable="true" std:desc="[Boolean] 엑셀 파일 Export 버튼 보이기 여부 (default: true)&#xD;&#xA;"/>
      <cl:property name="exportExcelTitle" type="string" bindable="true" std:desc="[String] 엑셀 Export 시, 엑셀 파일명 (default: title 속성값)"/>
      <cl:property name="exportHiddenColumn" type="boolean" default="false" bindable="true" std:desc="[Boolean] 엑셀 Export 시, 숨긴 컬럼도 포함시킬지 여부 (default: false) &#xD;&#xA;true 로 지정하면, 숨긴 컬럼도 엑셀 Export에 포함됩니다."/>
      <cl:property name="exportExcludeColumns" type="string" bindable="true" std:desc="[String] 엑셀 Export 시, 숨긴 컬럼 외 추가적으로 제외할 컬럼 (ex. COL1, COL2)"/>
      <cl:property name="exportExcludePart" type="string" bindable="true" std:desc="[String] 엑셀 Export 시, 출력 제외할 영역&#xD;&#xA;&#xD;&#xA;제외할 영역 (&#xD;&#xA;ex. footer, gfooter)"/>
      <cl:property name="exportType" type="enumeration" default="server" std:desc="[Enumeration] 엑셀 다운로드 방식 (default: server)&#xD;&#xA;">
        <cl:available-value>client</cl:available-value>
        <cl:available-value>server</cl:available-value>
      </cl:property>
      <cl:property name="exportApplyFormat" type="boolean" default="true" bindable="true" std:desc="[Boolean] 엑셀 Export 시, 포맷 적용시킬지 여부 (default: true)"/>
      <cl:property name="exportApplySuppress" type="boolean" default="true" bindable="true" std:desc="[Boolean] 엑셀 Export 시, suppress, mergedToIndexExpr에 의한 셀 병합을 반영할지 여부(default: true)"/>
      <cl:property name="exportshowRowIndex" type="boolean" default="false" bindable="true" std:desc="[Boolean] 엑셀 Export 시, rowindex 특수컬럼을 포함시킬지 여부 (default: false)"/>
      <cl:property name="exportApplyClassStyle" type="boolean" default="false" bindable="true" std:desc="[Boolean] 엑셀 Export 시, 클래스 스타일 적용 여부 (default: false)"/>
      <cl:property name="exportMassiveType" type="enumeration" default="standard" bindable="false" std:desc="[Enurmeration] 엑셀 Export 시, 다운로드 대용량 호출 방식 (default: standard) - exportType이 server인 경우에만 사용가능합니다. 그리드의 행이 20만행이 넘어가면 대용량 방식으로 설정됩니다">
        <cl:available-value>standard</cl:available-value>
        <cl:available-value>massive</cl:available-value>
      </cl:property>
    </cl:appspec>
  </head>
  <body std:sid="body-ab359a05" style="top:0px; left:0px; width:900px; height:26px;" class="title-area">
    <cl:listener std:sid="listener-5277be16" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-6811bb21" name="property-change" handler="onBodyPropertyChange"/>
    <cl:output std:sid="output-7a846500" id="optTilte" class="tit" value="그리드 타이틀">
      <cl:apppropbind property="value" app-property="title"/>
      <cl:formdata std:sid="f-data-0fce5e70" row="0" col="0"/>
    </cl:output>
    <cl:output std:sid="output-9645dacc" id="optRowCount" class="table-row-count" datatype="number" format="s#,##0" displayexp="&quot;총 &quot; + sstr(text) + &quot;건&quot;">
      <cl:apppropbind property="value" category="PROPERTY" app-property="rowCount"/>
      <cl:formdata std:sid="f-data-e2815aae" row="0" col="1"/>
    </cl:output>
    <cl:group std:sid="group-d7c87448">
      <cl:formdata std:sid="f-data-644ff709" row="0" col="2"/>
      <cl:button std:sid="button-a7838dc8" id="btnTools" class="btn-setting" fieldLabel="그리드 설정" tooltip="그리드 설정" icon="0">
        <cl:listener std:sid="listener-4be7d7c6" name="click" handler="onBtnToolsClick"/>
        <cl:flowlayoutdata std:sid="f-data-70a64448" width="26px" height="26px" autosize="width"/>
      </cl:button>
      <cl:button std:sid="button-2288c8ca" id="btnExcelExport" class="btn-excel" fieldLabel="엑셀다운로드" tooltip="엑셀다운로드" icon="0">
        <cl:listener std:sid="listener-091c33bb" name="click" handler="onBtnExcelExportClick"/>
        <cl:apppropbind property="visible" category="PROPERTY" app-property="showExportExcel"/>
        <cl:flowlayoutdata std:sid="f-data-42906441" width="26px" height="26px" autosize="width"/>
      </cl:button>
      <cl:flowlayout std:sid="f-layout-c0de2cea"/>
    </cl:group>
    <cl:formlayout std:sid="f-layout-975f7c47" scrollable="false" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="1" unit="FRACTION"/>
      <cl:columns length="200" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      <cl:columns length="45" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      <cl:columns length="1" unit="FRACTION"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>