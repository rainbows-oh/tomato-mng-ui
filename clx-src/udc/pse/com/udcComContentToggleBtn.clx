<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-99570d5c" version="1.0.6164">
  <head std:sid="head-bfddb556">
    <screen std:sid="screen-2a80f383" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-06d931c5" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-b8eba3ce" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-3e25ac19"/>
    <cl:appspec dev-description="btnShowGrid/btnShowCard 클릭에 따라 대상 그룹 두 개의 노출 여부를 전환하는 버튼" title="컨텐츠 그리드/카드 전환 버튼">
      <cl:property name="gridGroup" type="control" std:desc="[Group] btnShowGrid 클릭 시 보여줄 그룹(목록/그리드 영역) 컨트롤"/>
      <cl:property name="cardGroup" type="control" std:desc="[Group] btnShowCard 클릭 시 보여줄 그룹(카드 영역) 컨트롤"/>
    </cl:appspec>
  </head>
  <body std:sid="body-632b9903" style="top:0px; left:0px; width:68px; height:32px;" class="btn-content-toggle">
    <cl:listener std:sid="listener-4d4ba304" name="init" handler="onBodyInit"/>
    <cl:button std:sid="button-45caec0f" id="btnShowGrid" class="btn-show-grid icon" value="목록 그리드로 보기" icon="0">
      <cl:listener std:sid="listener-734145da" name="click" handler="onBtnShowGridClick"/>
      <cl:formdata std:sid="f-data-1b64c66f" row="0" col="0"/>
    </cl:button>
    <cl:button std:sid="button-246a30d3" id="btnShowCard" class="btn-show-card icon" value="목록 카드로 보기" icon="0">
      <cl:listener std:sid="listener-d1c05180" name="click" handler="onBtnShowCardClick"/>
      <cl:formdata std:sid="f-data-eb915ee3" row="0" col="1"/>
    </cl:button>
    <cl:formlayout std:sid="f-layout-6b2d6571" scrollable="false" hspace="4px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="32" unit="PIXEL"/>
      <cl:columns length="32" unit="PIXEL"/>
      <cl:columns length="32" unit="PIXEL"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>