<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-fa76058b" version="1.0.6164">
  <head std:sid="head-31fa6b5f">
    <screen std:sid="screen-9ea220c0" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-b760997a" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-ecf80c9f" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-368ed25d"/>
    <cl:appspec title="상세 페이지의 답글 종료 토글">
      <cl:property name="value" type="enumeration" default="value1" bindable="true" std:desc="[String] 선택된 값 (value1: Open, value2: Closed)">
        <cl:available-value>value1</cl:available-value>
        <cl:available-value>value2</cl:available-value>
      </cl:property>
    </cl:appspec>
  </head>
  <body std:sid="body-a9c272ed" style="top:0px; left:0px; width:140px; height:32px;">
    <cl:listener std:sid="listener-e7c82612" name="load" handler="onBodyLoad"/>
    <cl:radiobutton std:sid="r-button-ff3ee094" id="rdb1" class="rep-toggle" hspacing="0" hideicon="true" clickRegion="item">
      <cl:listener std:sid="listener-bdac4f04" name="selection-change" handler="onRdb1SelectionChange"/>
      <cl:apppropbind property="value" app-property="value"/>
      <cl:formdata std:sid="f-data-8cde5bf2" row="0" col="0"/>
      <cl:item std:sid="item-9bee1bd6" label="Open" value="value1"/>
      <cl:item std:sid="item-98f6f051" label="Closed" value="value2"/>
      <cl:itemstyle>
        <cl:expbind property="class" category="CLASS" expression="value == &quot;value1&quot; ? &quot;open&quot; : &quot;close&quot;"/>
      </cl:itemstyle>
    </cl:radiobutton>
    <cl:formlayout std:sid="f-layout-74dd3eb6" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="1" unit="FRACTION"/>
      <cl:columns length="140" unit="PIXEL" autoSizing="true" syncminlength="false"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>