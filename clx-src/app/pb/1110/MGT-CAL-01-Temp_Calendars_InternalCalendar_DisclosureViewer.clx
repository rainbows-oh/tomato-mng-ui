          <cl:output std:sid="output-71e0c07e" id="opt9" class="font-title" value="Property Ex-Date">
            <cl:verticaldata std:sid="v-data-206f5c66" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:output std:sid="output-21da8978" id="opt10" class="font-body" value="Jollibee Foods Corporation (“the Company”) hereby discloses the following information in accordance with the Revised Disclosure Rules of the Philippine Stock Exchange.">
            <cl:verticaldata std:sid="v-data-00745130" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:output std:sid="output-f8eb18b9" id="opt11" class="font-body" value="This filing relates to “Property Ex-Date” and is submitted for the information of the investing public. The Company confirms that the statements herein are true and correct based on records available as of Aug 5, 2026.">
            <cl:verticaldata std:sid="v-data-df1461aa" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:output std:sid="output-015c33b2" id="opt12" class="font-body" value="Unless otherwise indicated, figures are expressed in Philippine pesos. Interested parties may refer to the attachments for supporting schedules and board approvals.">
            <cl:verticaldata std:sid="v-data-359eeefb" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:output std:sid="output-c60a3cab" id="opt13" class="font-body" value="The Company undertakes to update this disclosure should any material change arise subsequent to this filing.">
            <cl:verticaldata std:sid="v-data-3729c619" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:verticallayout std:sid="v-layout-f5cae3bf" spacing="8"/>
