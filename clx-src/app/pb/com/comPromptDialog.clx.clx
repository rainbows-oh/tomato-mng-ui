  <body std:sid="body-74fbd956">
    <cl:group std:sid="group-a825e156" id="grp1">
      <cl:formdata std:sid="f-data-b63413be" width="100" height="109" row="0" col="0"/>
      <cl:output std:sid="output-f64f1c9a" id="opt1" style="font-weight:700;" class="font-heading" value="Reject Disclosure">
        <cl:verticaldata std:sid="v-data-95217212" width="100px" height="20px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-7aabf18f" id="opt2" class="font-body" value="Please enter the reason for rejection.">
        <cl:verticaldata std:sid="v-data-f8a129f8" width="100px" height="20px" autosize="height"/>
      </cl:output>
      <cl:group std:sid="group-ef318d90" id="grp3">
        <cl:attribute name="needs-auto-height" value="true"/>
