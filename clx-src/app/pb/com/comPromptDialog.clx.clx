        </cl:button>
        <cl:button std:sid="button-285fe5fd" id="btn3" class="btn-danger" value="Reject">
          <cl:flowlayoutdata std:sid="f-data-f2148c12" width="100px" height="36px" autosize="width"/>
        </cl:button>
        <cl:flowlayout std:sid="f-layout-6d2c4362" halign="right"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-f01164e5" spacing="12" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
