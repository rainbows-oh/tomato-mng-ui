        <cl:output std:sid="output-42a8bc12" id="opt3" class="font-label required" value="Remark">
          <cl:verticaldata std:sid="v-data-4d3e31ae" width="100px" height="18px" autosize="height"/>
        </cl:output>
        <cl:textarea std:sid="t-area-3f700ee4" id="txa1" placeholder="Enter a remark">
