          </cl:button>
          <cl:flowlayout std:sid="f-layout-0dfd9082"/>
        </cl:group>
        <cl:group std:sid="group-6fa7601e" id="grpSubmit">
          <cl:attribute name="needs-auto-height" value="true"/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="mobile-index" value="0"/>
          <cl:formdata std:sid="f-data-4709687c" row="0" col="1"/>
          <cl:output std:sid="output-f54cd4c7" id="optLabelEndorse" class="font-label required" value="Endorse To">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:formdata std:sid="f-data-5d252286" row="0" col="0"/>
          </cl:output>
          <cl:group std:sid="group-0c8d8fd7" id="grp3">
            <cl:formdata std:sid="f-data-77ed797c" row="0" col="1"/>
            <cl:combobox std:sid="c-box-e59d0db6" id="cmb1" fieldLabel="Endorse To" placeholder="Select approver">
              <cl:formdata std:sid="f-data-c17fe295" row="0" col="0"/>
            </cl:combobox>
            <cl:button std:sid="button-b4a171a7" id="btnSubmit" class="btn-primary" value="Submit">
              <cl:formdata std:sid="f-data-e54b9391" row="0" col="1"/>
            </cl:button>
            <cl:formlayout std:sid="f-layout-7e7184ad" scrollable="false" hspace="8px" vspace="12px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
              <cl:rows length="36" unit="PIXEL"/>
              <cl:columns length="1" unit="FRACTION"/>
              <cl:columns length="100" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            </cl:formlayout>
          </cl:group>
          <cl:formlayout std:sid="f-layout-02b992a7" scrollable="false" hspace="8px" vspace="4px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="100" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:formlayout std:sid="f-layout-b2eefcdd" scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
          <cl:columns length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
        </cl:formlayout>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-75ec9db6" spacing="20" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-c56a26cf" spacing="18"/>
  </body>
