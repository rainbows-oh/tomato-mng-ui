  <head std:sid="head-ec4ee482">
    <screen std:sid="screen-1c425079" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f3abc1ae" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f0487b32" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-f5dd3c0f"/>
    <cl:appspec title="New Manual Disclosure 등록 팝업"/>
  </head>
  <body std:sid="body-fa5f6637" style="top:0px; left:0px; width:700px; height:760px;">
    <cl:group std:sid="group-aeb301ea" id="grpBody">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-bottom-margin" value="16"/>
      <cl:attribute name="mobile-left-margin" value="16"/>
      <cl:attribute name="mobile-right-margin" value="16"/>
      <cl:attribute name="mobile-top-margin" value="16"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:verticaldata std:sid="v-data-f9431e1f" width="1024px" height="709px" autosize="height"/>
      <cl:group std:sid="group-ae9247b4" id="grpContentHeader">
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:attribute name="mobile-spacing" value="14"/>
        <cl:verticaldata std:sid="v-data-094c99ed" width="976px" height="36px" autosize="height"/>
        <cl:group std:sid="group-8077bed4" id="grpPreview">
          <cl:verticaldata std:sid="v-data-4d939dbc" width="976px" height="36px" autosize="height"/>
          <cl:button std:sid="button-b2096fa2" id="btnPreview" class="btn-secondary" value="Preview">
            <cl:flowlayoutdata std:sid="f-data-ee2f960e" width="100px" height="36px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-437fba98" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-f6c527aa" spacing="16"/>
      </cl:group>
      <cl:group std:sid="group-f547834e" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:attribute name="mobile-spacing" value="14"/>
        <cl:verticaldata std:sid="v-data-7164b5b2" width="976px" height="532px" autosize="height"/>
        <cl:group std:sid="group-eaa2b5c7" id="grpField1">
          <cl:verticaldata std:sid="v-data-05436d0b" width="976px" height="60px" autosize="height"/>
          <cl:output std:sid="output-0f433303" id="optLabel1" class="font-label required" value="Company Name">
            <cl:verticaldata std:sid="v-data-6b658e21" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:inputbox std:sid="i-box-57a1ad7f" id="ipb1" fieldLabel="Company Name" placeholder="Type to search company name...">
            <cl:verticaldata std:sid="v-data-928b6f36" width="100px" height="36px"/>
          </cl:inputbox>
          <cl:verticallayout std:sid="v-layout-81943374" scrollable="false" spacing="4"/>
        </cl:group>
        <cl:group std:sid="group-e5cef13e" id="grpField2">
          <cl:verticaldata std:sid="v-data-ba4cae1a" width="976px" height="60px" autosize="height"/>
          <cl:output std:sid="output-a62db6f8" id="optLabel2" class="font-label required" value="Template Name">
            <cl:verticaldata std:sid="v-data-cfa33747" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:inputbox std:sid="i-box-2f87f9a4" id="ipb2" fieldLabel="Template Name" placeholder="Type to search template name...">
            <cl:verticaldata std:sid="v-data-bc46caeb" width="100px" height="36px"/>
          </cl:inputbox>
          <cl:verticallayout std:sid="v-layout-463c30cb" scrollable="false" spacing="4"/>
        </cl:group>
        <cl:group std:sid="group-6369faa5" id="grpField3">
          <cl:verticaldata std:sid="v-data-8f2b6469" width="976px" height="60px" autosize="height"/>
          <cl:output std:sid="output-4e721523" id="optLabel3" class="font-label required" value="Report Date">
            <cl:verticaldata std:sid="v-data-26a79139" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:dateinput std:sid="d-input-58a4054d" id="dti1" fieldLabel="Report Date" hidebutton="true" placeholder="MM-DD-YYYY">
            <cl:verticaldata std:sid="v-data-ace1444e" width="100px" height="36px"/>
          </cl:dateinput>
          <cl:verticallayout std:sid="v-layout-bebf06b2" scrollable="false" spacing="4"/>
        </cl:group>
        <cl:group std:sid="group-3a81c5ff" id="grpField4">
          <cl:verticaldata std:sid="v-data-1f599d01" width="976px" height="164px" autosize="height"/>
          <cl:output std:sid="output-07837972" id="optLabel4" class="font-label required" value="Attach File">
            <cl:verticaldata std:sid="v-data-e895ed66" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:udc std:sid="ud-control-8bcf7296" id="udccomfiledropzone1" type="udc.pse.com.udcComFileDropzone">
            <cl:verticaldata std:sid="v-data-54cd9616" width="600px" height="140px" autosize="height"/>
            <cl:property name="isTypeInfoVisible" value="true" type="boolean"/>
            <cl:property name="typeInfo" value="Only PDF or image files are allowed." type="string"/>
          </cl:udc>
          <cl:verticallayout std:sid="v-layout-28e29931" scrollable="false" spacing="4"/>
        </cl:group>
        <cl:group std:sid="group-397dcdef" id="grpField5">
          <cl:verticaldata std:sid="v-data-b0430023" width="976px" height="124px" autosize="height"/>
          <cl:output std:sid="output-d6ccf485" id="optLabel5" class="font-label" value="Remarks">
            <cl:verticaldata std:sid="v-data-8f1a8d01" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:textarea std:sid="t-area-65fac7ff" id="txa1" fieldLabel="Remarks" placeholder="Enter text">
            <cl:verticaldata std:sid="v-data-d32287cf" width="100px" height="100px"/>
          </cl:textarea>
          <cl:verticallayout std:sid="v-layout-d69eed04" scrollable="false" spacing="4"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-11d46297" spacing="16"/>
      </cl:group>
      <cl:group std:sid="group-af78ab22" id="grpFooter" class="btn-footer-wrap">
        <cl:attribute name="mobile-column-count" value="1"/>
        <cl:attribute name="needs-auto-height" value="true"/>
        <cl:verticaldata std:sid="v-data-10767a7c" width="976px" height="57px" autosize="height"/>
        <cl:group std:sid="group-42420b7f" id="grp2">
          <cl:attribute name="needs-auto-height" value="true"/>
          <cl:attribute name="mobile-index" value="1"/>
          <cl:formdata std:sid="f-data-c0f43170" row="0" col="0" rowspan="1" colspan="1"/>
          <cl:button std:sid="button-9d93fd7a" id="btnCancel" class="btn-secondary" value="Cancel">
