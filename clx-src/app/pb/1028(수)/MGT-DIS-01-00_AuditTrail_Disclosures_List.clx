          <cl:gridheader std:sid="gh-band-d28a541f">
            <cl:gridrow std:sid="g-row-d576d7a2" height="37px"/>
            <cl:gridcell std:sid="gh-cell-00000013" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No."/>
            <cl:gridcell std:sid="gh-cell-00000014" rowindex="0" colindex="1" targetcolumnname="refNo" sortable="true" filterable="false" text="Reference No."/>
            <cl:gridcell std:sid="gh-cell-00000015" rowindex="0" colindex="2" targetcolumnname="companyName" sortable="true" filterable="false" text="Company Name"/>
            <cl:gridcell std:sid="gh-cell-00000016" rowindex="0" colindex="3" targetcolumnname="templateName" sortable="true" filterable="false" text="Template Name"/>
            <cl:gridcell std:sid="gh-cell-00000017" rowindex="0" colindex="4" targetcolumnname="submittedAt" sortable="true" filterable="false" text="Date and Time"/>
            <cl:gridcell std:sid="gh-cell-00000018" rowindex="0" colindex="5" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-00000019" rowindex="0" colindex="6" targetcolumnname="updatedBy" sortable="true" filterable="false" text="Updated By"/>
            <cl:gridcell std:sid="gh-cell-0000001a" rowindex="0" colindex="7" targetcolumnname="assignedTo" sortable="true" filterable="false" text="Assigned To"/>
            <cl:gridcell std:sid="gh-cell-0000001b" rowindex="0" colindex="8" targetcolumnname="hasRemark" sortable="false" filterable="false" text="Remarks"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-93b884d1">
            <cl:gridrow std:sid="g-row-8d12379b" height="54px"/>
            <cl:gridcell std:sid="gd-cell-0000001c" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-0000001f" rowindex="0" colindex="1" columnname="refNo">
              <cl:output std:sid="output-00000020">
                <cl:expbind property="value" category="PROPERTY" expression="refNo"/>
                <cl:celldata std:sid="c-data-00000021"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000022" rowindex="0" colindex="2" columnname="companyName">
              <cl:button std:sid="button-00000023" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="companyName"/>
                <cl:celldata std:sid="c-data-00000024"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000025" rowindex="0" colindex="3" columnname="templateName">
              <cl:button std:sid="button-00000026" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="templateName"/>
                <cl:celldata std:sid="c-data-00000027"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000028" rowindex="0" colindex="4" columnname="submittedAt">
              <cl:output std:sid="output-00000029" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="submittedAt"/>
                <cl:celldata std:sid="c-data-0000002a"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000002b" rowindex="0" colindex="5" columnname="status">
              <cl:output std:sid="output-0000002c" class="badge fill" displayexp="sstr(text, switch(status){&#xD;&#xA;&#x9;case &quot;Cancelled&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="status"/>
                <cl:expbind property="class" category="CLASS" expression="(status == &quot;Rejected&quot; || status == &quot;Cancelled&quot;) ? &quot;red&quot; : &quot;blue&quot;"/>
                <cl:celldata std:sid="c-data-0000002d"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000002e" rowindex="0" colindex="6" columnname="updatedBy">
              <cl:output std:sid="output-0000002f">
                <cl:expbind property="value" category="PROPERTY" expression="updatedBy"/>
                <cl:celldata std:sid="c-data-00000030"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000031" rowindex="0" colindex="7" columnname="assignedTo">
              <cl:output std:sid="output-00000032">
                <cl:expbind property="value" category="PROPERTY" expression="assignedTo"/>
                <cl:celldata std:sid="c-data-00000033"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000034" rowindex="0" colindex="8">
              <cl:button std:sid="button-00000036" icon="0">
                <cl:expbind property="class" category="CLASS" expression="hasRemark == &quot;Y&quot; ? &quot;btn-file icon&quot; : &quot;icon btn-plus&quot;"/>
                <cl:celldata std:sid="c-data-b7ced248" halign="CENTER" valign="CENTER" width="28" height="28"/>
              </cl:button>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
