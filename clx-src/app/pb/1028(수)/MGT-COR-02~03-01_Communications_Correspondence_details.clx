    <cl:model std:sid="model-e918cc57"/>
    <cl:appspec dev-comment="상단 우측의 라디오 버튼은 화면 호출 확인용입니다. 개발시 필요 없으시면 삭제하셔도 됩니다." title="Correspondence_details"/>
