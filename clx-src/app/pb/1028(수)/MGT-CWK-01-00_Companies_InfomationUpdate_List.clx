          <cl:attribute name="mobile-spacing" value="14"/>
          <cl:verticaldata std:sid="v-data-85fc84d5" width="974px" height="243px" autosize="height"/>
          <cl:group std:sid="group-bc2a3258" class="filter-form">
            <cl:verticaldata std:sid="v-data-d17e9f6b" width="926px" height="60px" autosize="height"/>
            <cl:group std:sid="group-00000058" class="row">
              <cl:attribute name="mobile-column-count" value="1"/>
              <cl:verticaldata std:sid="v-data-00000059" width="926px" height="60px" autosize="height"/>
              <cl:group std:sid="group-00000050">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-00000051" width="457" height="27" row="0" col="0"/>
                <cl:output std:sid="output-0000004e" class="font-label" value="Company Name">
                  <cl:verticaldata std:sid="v-data-0000004f" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:group std:sid="group-0000003f" class="input-group">
                  <cl:attribute name="mobile-column-count" value="1"/>
                  <cl:verticaldata std:sid="v-data-00000040" width="457px" height="36px" autosize="height"/>
                  <cl:combobox std:sid="c-box-00000041" fieldLabel="Select Company Name" value="value1">
                    <cl:formdata std:sid="f-data-00000042" row="0" col="0"/>
                    <cl:item std:sid="t-item-085677ca" label="All" value="value1"/>
                  </cl:combobox>
                  <cl:inputbox std:sid="i-box-00000043" fieldLabel="Company Name" placeholder="Enter a company name or stock symbol">
                    <cl:formdata std:sid="f-data-00000044" row="0" col="1"/>
                  </cl:inputbox>
                  <cl:formlayout std:sid="f-layout-00000045" scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                    <cl:rows length="36" unit="PIXEL"/>
                    <cl:columns length="160" unit="PIXEL"/>
                    <cl:columns length="1" unit="FRACTION"/>
                  </cl:formlayout>
                </cl:group>
                <cl:verticallayout std:sid="v-layout-00000052" spacing="6"/>
              </cl:group>
