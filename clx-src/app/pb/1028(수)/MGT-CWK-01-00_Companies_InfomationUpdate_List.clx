      </cl:group>
      <cl:group std:sid="group-6a84c5cc" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-spacing" value="16"/>
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:verticaldata std:sid="v-data-fc0c0fb0" width="976px" height="316px" autosize="height"/>
        <cl:group std:sid="group-5d5796c1" class="search-list-top">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata std:sid="v-data-71103673" width="400px" height="36px" autosize="height"/>
          <cl:output std:sid="output-3ac2ed84" class="sch-info" value="14" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; company updates&quot;">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:formdata std:sid="f-data-c4b6fe60" row="0" col="0"/>
          </cl:output>
          <cl:group std:sid="group-5c3d9eb9">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:formdata std:sid="f-data-15a35e88" row="0" col="1"/>
            <cl:button std:sid="button-d5b375b3" class="btn-inline btn-file" value="Excel Download" icon="0">
              <cl:flowlayoutdata std:sid="f-data-cef36371" width="133px" height="36px" autosize="width"/>
            </cl:button>
            <cl:combobox std:sid="c-box-d195aaaa" fieldLabel="Rows per page" value="15">
              <cl:flowlayoutdata std:sid="f-data-9b5dca83" width="110px" height="36px"/>
              <cl:item std:sid="t-item-sa000201" label="15/page" value="15"/>
            </cl:combobox>
            <cl:flowlayout std:sid="f-layout-3ac577df" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-da312581" scrollable="false" hspace="1fr" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="422" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-25fbe45e" datasetid="dsList" autofit="1, 2, 3, 4" resizablecolumns="all" columnMovable="true">
          <cl:verticaldata std:sid="v-data-6b21a1a8" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-0000000a" width="52px"/>
          <cl:gridcolumn std:sid="g-column-0000000b" width="400px"/>
          <cl:gridcolumn std:sid="g-column-0000000c" width="220px"/>
          <cl:gridcolumn std:sid="g-column-0000000d" width="200px"/>
          <cl:gridcolumn std:sid="g-column-0000000e" width="200px"/>
          <cl:gridheader std:sid="gh-band-d28a541f">
            <cl:gridrow std:sid="g-row-d576d7a2" height="37px"/>
            <cl:gridcell std:sid="gh-cell-00000013" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No"/>
            <cl:gridcell std:sid="gh-cell-00000014" rowindex="0" colindex="1" targetcolumnname="companyName" sortable="true" filterable="false" text="Company Name"/>
            <cl:gridcell std:sid="gh-cell-00000015" rowindex="0" colindex="2" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-00000016" rowindex="0" colindex="3" targetcolumnname="submittedAt" sortable="true" filterable="false" text="Submission Date and Time"/>
            <cl:gridcell std:sid="gh-cell-00000017" rowindex="0" colindex="4" targetcolumnname="approvedAt" sortable="true" filterable="false" text="LC Approval Date and Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-93b884d1">
            <cl:gridrow std:sid="g-row-8d12379b" height="54px"/>
            <cl:gridcell std:sid="gd-cell-0000001c" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-00000022" rowindex="0" colindex="1" columnname="companyName">
              <cl:button std:sid="button-00000023" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="companyName"/>
                <cl:celldata std:sid="c-data-00000024"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000002b" rowindex="0" colindex="2" columnname="status">
              <cl:output std:sid="output-0000002c" class="badge fill" displayexp="sstr(text, switch(status){&#xD;&#xA;&#x9;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="status"/>
                <cl:expbind property="class" category="CLASS" expression="(status == &quot;Rejected&quot;) ? &quot;red&quot; : &quot;blue&quot;"/>
                <cl:celldata std:sid="c-data-0000002d"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000028" rowindex="0" colindex="3" columnname="submittedAt">
              <cl:output std:sid="output-00000028" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="submittedAt"/>
                <cl:celldata std:sid="c-data-00000028"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000031" rowindex="0" colindex="4" columnname="approvedAt">
              <cl:output std:sid="output-00000031" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="approvedAt"/>
                <cl:celldata std:sid="c-data-00000031"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:udc std:sid="ud-control-eaa7f396" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-98b2d615" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-40e46285" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-fc7fc5a9" scrollable="false" spacing="20" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
