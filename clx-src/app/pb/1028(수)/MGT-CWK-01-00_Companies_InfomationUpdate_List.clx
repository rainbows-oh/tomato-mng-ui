                </cl:output>
                <cl:combobox std:sid="c-box-2f69988b" fieldLabel="Status" value="value1">
                  <cl:verticaldata std:sid="v-data-9890fa69" width="457px" height="36px" autosize="none"/>
                  <cl:item std:sid="t-item-b8411ba0" label="All" value="value1"/>
                </cl:combobox>
                <cl:verticallayout std:sid="v-layout-00000057" spacing="6"/>
              </cl:group>
              <cl:formlayout std:sid="f-layout-0000005a" scrollable="false" hspace="12px" vspace="14px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                <cl:rows length="1" unit="FRACTION"/>
                <cl:columns length="3" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
              </cl:formlayout>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-0000006d" scrollable="false" spacing="14"/>
          </cl:group>
