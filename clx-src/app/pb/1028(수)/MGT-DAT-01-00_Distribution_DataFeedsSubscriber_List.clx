          <cl:gridcolumn std:sid="g-column-00000122" width="180px"/>
          <cl:gridheader std:sid="gh-band-d28a541f">
            <cl:gridrow std:sid="g-row-d576d7a2" height="37px"/>
            <cl:gridcell std:sid="gh-cell-00000123" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No."/>
            <cl:gridcell std:sid="gh-cell-00000124" rowindex="0" colindex="1" targetcolumnname="subId" sortable="true" filterable="false" text="Subscriber ID"/>
            <cl:gridcell std:sid="gh-cell-00000125" rowindex="0" colindex="2" targetcolumnname="subName" sortable="true" filterable="false" text="Subscriber Name"/>
            <cl:gridcell std:sid="gh-cell-00000126" rowindex="0" colindex="3" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-00000127" rowindex="0" colindex="4" targetcolumnname="startDate" sortable="true" filterable="false" text="Start Date"/>
            <cl:gridcell std:sid="gh-cell-00000128" rowindex="0" colindex="5" targetcolumnname="endDate" sortable="true" filterable="false" text="End Date"/>
            <cl:gridcell std:sid="gh-cell-00000129" rowindex="0" colindex="6" targetcolumnname="submittedAt" sortable="true" filterable="false" text="Submitted Date"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-93b884d1">
            <cl:gridrow std:sid="g-row-8d12379b" height="54px"/>
            <cl:gridcell std:sid="gd-cell-0000012a" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-0000012b" rowindex="0" colindex="1" columnname="subId">
              <cl:output std:sid="output-0000012c">
                <cl:expbind property="value" category="PROPERTY" expression="subId"/>
                <cl:celldata std:sid="c-data-0000012d"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000116" rowindex="0" colindex="2" columnname="subName">
              <cl:button std:sid="button-00000117" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="subName"/>
                <cl:celldata std:sid="c-data-00000118"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000119" rowindex="0" colindex="3" columnname="status">
              <cl:output std:sid="output-0000011a" class="badge fill" displayexp="sstr(text, switch(status){&#xD;&#xA;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="status"/>
                <cl:expbind property="class" category="CLASS" expression="(status == &quot;Rejected&quot;) ? &quot;red&quot; : &quot;blue&quot;"/>
                <cl:celldata std:sid="c-data-0000011b"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000012e" rowindex="0" colindex="4" columnname="startDate">
              <cl:output std:sid="output-0000012f" datatype="date" format="MM-DD-YYYY">
                <cl:expbind property="value" category="PROPERTY" expression="startDate"/>
                <cl:celldata std:sid="c-data-00000130"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000131" rowindex="0" colindex="5" columnname="endDate">
              <cl:output std:sid="output-00000132" datatype="date" format="MM-DD-YYYY">
                <cl:expbind property="value" category="PROPERTY" expression="endDate"/>
                <cl:celldata std:sid="c-data-00000133"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000134" rowindex="0" colindex="6" columnname="submittedAt">
              <cl:output std:sid="output-00000135" datatype="date" format="MM-DD-YYYY">
                <cl:expbind property="value" category="PROPERTY" expression="submittedAt"/>
                <cl:celldata std:sid="c-data-00000136"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
