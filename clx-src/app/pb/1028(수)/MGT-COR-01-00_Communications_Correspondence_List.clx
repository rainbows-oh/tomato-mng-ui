            <cl:button std:sid="button-1a5d6b29" class="btn-secondary" value="Clear">
              <cl:flowlayoutdata std:sid="f-data-c07e8d8d" width="69px" height="36px" autosize="width"/>
            </cl:button>
            <cl:button std:sid="button-748f6743" class="btn-search" value="Search" icon="0">
              <cl:flowlayoutdata std:sid="f-data-d7f5f78d" width="104px" height="36px" autosize="width"/>
            </cl:button>
            <cl:flowlayout std:sid="f-layout-3c093e4d" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
