            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="422" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-25fbe45e" datasetid="dsList" autofit="1, 2, 3, 4, 5, 6, 7, 8" resizablecolumns="1, 2, 3, 4, 5, 6, 7, 8" columnMovable="true">
          <cl:verticaldata std:sid="v-data-6b21a1a8" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-0000015a" width="52px"/>
          <cl:gridcolumn std:sid="g-column-0000015b" width="120px"/>
          <cl:gridcolumn std:sid="g-column-0000015c" width="140px"/>
          <cl:gridcolumn std:sid="g-column-0000015d" width="300px"/>
          <cl:gridcolumn std:sid="g-column-0000015e" width="280px"/>
          <cl:gridcolumn std:sid="g-column-0000015f" width="160px"/>
          <cl:gridcolumn std:sid="g-column-00000160" width="220px"/>
          <cl:gridcolumn std:sid="g-column-00000161" width="220px"/>
          <cl:gridcolumn std:sid="g-column-00000162" width="160px"/>
          <cl:gridheader std:sid="gh-band-d28a541f">
            <cl:gridrow std:sid="g-row-d576d7a2" height="37px"/>
            <cl:gridcell std:sid="gh-cell-00000163" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No."/>
            <cl:gridcell std:sid="gh-cell-00000164" rowindex="0" colindex="1" targetcolumnname="reportNo" sortable="true" filterable="false" text="Report No"/>
            <cl:gridcell std:sid="gh-cell-00000165" rowindex="0" colindex="2" targetcolumnname="refNo" sortable="true" filterable="false" text="Ref. No"/>
            <cl:gridcell std:sid="gh-cell-00000166" rowindex="0" colindex="3" targetcolumnname="companyName" sortable="true" filterable="false" text="Company Name"/>
            <cl:gridcell std:sid="gh-cell-00000167" rowindex="0" colindex="4" targetcolumnname="subject" sortable="true" filterable="false" text="Subject"/>
            <cl:gridcell std:sid="gh-cell-00000168" rowindex="0" colindex="5" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-00000169" rowindex="0" colindex="6" targetcolumnname="submittedAt" sortable="true" filterable="false" text="Submission Date and Time"/>
            <cl:gridcell std:sid="gh-cell-0000016a" rowindex="0" colindex="7" targetcolumnname="approvedAt" sortable="true" filterable="false" text="Approval Date and Time"/>
            <cl:gridcell std:sid="gh-cell-0000016b" rowindex="0" colindex="8" targetcolumnname="updatedBy" sortable="true" filterable="false" text="Last Updated By"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-93b884d1">
            <cl:gridrow std:sid="g-row-8d12379b" height="54px"/>
            <cl:gridcell std:sid="gd-cell-0000016c" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-0000016d" rowindex="0" colindex="1" columnname="reportNo">
              <cl:output std:sid="output-0000016e">
                <cl:expbind property="value" category="PROPERTY" expression="reportNo"/>
                <cl:celldata std:sid="c-data-0000016f"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000170" rowindex="0" colindex="2" columnname="refNo">
              <cl:output std:sid="output-00000171">
                <cl:expbind property="value" category="PROPERTY" expression="refNo"/>
                <cl:celldata std:sid="c-data-00000172"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000173" rowindex="0" colindex="3" columnname="companyName">
              <cl:button std:sid="button-00000174" class="btn-link" displayexp="delisted == &quot;Y&quot; ? sstr(&quot;[Delisted] &quot;, {&quot;color&quot;: &quot;#64748B&quot;,&quot;font-size&quot;: &quot;11px&quot;}) +text : text">
                <cl:expbind property="value" category="PROPERTY" expression="companyName"/>
                <cl:celldata std:sid="c-data-00000175"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000176" rowindex="0" colindex="4" columnname="subject">
              <cl:button std:sid="button-00000177" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="subject"/>
                <cl:celldata std:sid="c-data-00000178"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000157" rowindex="0" colindex="5" columnname="status">
              <cl:output std:sid="output-00000158" class="badge fill" displayexp="sstr(text, switch(status){&#xD;&#xA;&#x9;case &quot;Cancelled&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="status"/>
                <cl:expbind property="class" category="CLASS" expression="(status == &quot;Rejected&quot; || status == &quot;Cancelled&quot;) ? &quot;red&quot; : &quot;blue&quot;"/>
                <cl:celldata std:sid="c-data-00000159"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000179" rowindex="0" colindex="6" columnname="submittedAt">
              <cl:output std:sid="output-0000017a" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="submittedAt"/>
                <cl:celldata std:sid="c-data-0000017b"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000017c" rowindex="0" colindex="7" columnname="approvedAt">
              <cl:output std:sid="output-0000017d" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="approvedAt"/>
                <cl:celldata std:sid="c-data-0000017e"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000017f" rowindex="0" colindex="8" columnname="updatedBy">
              <cl:output std:sid="output-00000180">
                <cl:expbind property="value" category="PROPERTY" expression="updatedBy"/>
                <cl:celldata std:sid="c-data-00000181"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:udc std:sid="ud-control-eaa7f396" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-98b2d615" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-40e46285" scrollable="false" spacing="20"/>
