            <cl:gridcell std:sid="gh-cell-00000140" rowindex="0" colindex="1" targetcolumnname="refNo" sortable="true" filterable="false" text="Ref. No"/>
            <cl:gridcell std:sid="gh-cell-00000141" rowindex="0" colindex="2" targetcolumnname="companyName" sortable="true" filterable="false" text="Company Name"/>
            <cl:gridcell std:sid="gh-cell-00000142" rowindex="0" colindex="3" targetcolumnname="subject" sortable="true" filterable="false" text="Subject"/>
            <cl:gridcell std:sid="gh-cell-00000143" rowindex="0" colindex="4" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-00000144" rowindex="0" colindex="5" targetcolumnname="submittedAt" sortable="true" filterable="false" text="Submission Date and Time"/>
            <cl:gridcell std:sid="gh-cell-00000145" rowindex="0" colindex="6" targetcolumnname="updatedAt" sortable="true" filterable="false" text="Update Date and Time"/>
            <cl:gridcell std:sid="gh-cell-00000146" rowindex="0" colindex="7" targetcolumnname="updatedBy" sortable="true" filterable="false" text="Last Updated By"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-93b884d1">
            <cl:gridrow std:sid="g-row-8d12379b" height="54px"/>
            <cl:gridcell std:sid="gd-cell-00000147" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-00000148" rowindex="0" colindex="1" columnname="refNo">
              <cl:output std:sid="output-00000149">
                <cl:expbind property="value" category="PROPERTY" expression="refNo"/>
                <cl:celldata std:sid="c-data-0000014a"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000014b" rowindex="0" colindex="2" columnname="companyName">
              <cl:button std:sid="button-0000014c" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="companyName"/>
                <cl:celldata std:sid="c-data-0000014d"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000014e" rowindex="0" colindex="3" columnname="subject">
              <cl:button std:sid="button-0000014f" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="subject"/>
                <cl:celldata std:sid="c-data-00000150"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000134" rowindex="0" colindex="4" columnname="status">
              <cl:output std:sid="output-00000135" class="badge fill" displayexp="sstr(text, switch(status){&#xD;&#xA;&#x9;case &quot;Cancelled&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="status"/>
                <cl:expbind property="class" category="CLASS" expression="(status == &quot;Rejected&quot; || status == &quot;Cancelled&quot;) ? &quot;red&quot; : &quot;blue&quot;"/>
                <cl:celldata std:sid="c-data-00000136"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000151" rowindex="0" colindex="5" columnname="submittedAt">
              <cl:output std:sid="output-00000152" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="submittedAt"/>
                <cl:celldata std:sid="c-data-00000153"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000154" rowindex="0" colindex="6" columnname="updatedAt">
              <cl:output std:sid="output-00000155" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:expbind property="value" category="PROPERTY" expression="updatedAt"/>
                <cl:celldata std:sid="c-data-00000156"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000157" rowindex="0" colindex="7" columnname="updatedBy">
              <cl:output std:sid="output-00000158">
                <cl:expbind property="value" category="PROPERTY" expression="updatedBy"/>
                <cl:celldata std:sid="c-data-00000159"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
