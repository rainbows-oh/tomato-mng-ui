<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-10700f40" version="1.0.6164">
  <head std:sid="head-ec4ee482">
    <std:metadata>
      <std:property key="template-file" value="templates/management/CompanyName_조회_팝업.clx"/>
    </std:metadata>
    <screen std:sid="screen-1c425079" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f3abc1ae" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f0487b32" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-f5dd3c0f"/>
    <cl:appspec/>
  </head>
  <body std:sid="body-fa5f6637" style="top:0px; left:0px; width:640px; height:520px;" class="auth">
    <cl:group std:sid="group-aeb301ea" id="grpBody">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-bottom-margin" value="16"/>
      <cl:attribute name="mobile-left-margin" value="16"/>
      <cl:attribute name="mobile-right-margin" value="16"/>
      <cl:attribute name="mobile-top-margin" value="16"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:verticaldata std:sid="v-data-f9431e1f" width="1024px" height="673px" autosize="height"/>
      <cl:group std:sid="group-9c6d43b3" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:attribute name="mobile-spacing" value="14"/>
        <cl:verticaldata std:sid="v-data-4109c237" width="976px" height="609px" autosize="height"/>
        <cl:group std:sid="group-4006bfd4" id="grp2" class="separate">
          <cl:verticaldata std:sid="v-data-75111c52" width="976px" height="511px" autosize="height"/>
          <cl:group std:sid="group-61a6e92c" id="grp3">
            <cl:verticaldata std:sid="v-data-8d47903c" width="976px" height="56px" autosize="both"/>
            <cl:output std:sid="output-5b5691f9" id="opt1" class="tit" value="Reset Password">
              <cl:verticaldata std:sid="v-data-af7dbc36" width="100px" height="30px" autosize="both"/>
            </cl:output>
            <cl:output std:sid="output-0ce96798" id="opt2" class="sub-tit" value="Create a new password">
              <cl:verticaldata std:sid="v-data-77334901" width="100px" height="20px" autosize="height"/>
            </cl:output>
            <cl:verticallayout std:sid="v-layout-4775946b" spacing="6"/>
          </cl:group>
          <cl:group std:sid="group-77535c54" id="grp7">
            <cl:verticaldata std:sid="v-data-118c1f40" width="976px" height="168px" autosize="height"/>
            <cl:group std:sid="group-b5f4f056" id="grp1">
              <cl:verticaldata std:sid="v-data-110316be" width="976px" height="64px" autosize="height"/>
              <cl:output std:sid="output-373e0e8f" id="opt4" class="label" value="New Password">
                <cl:verticaldata std:sid="v-data-49c25b03" width="100px" height="18px" autosize="height"/>
              </cl:output>
              <cl:group std:sid="group-a28bcfba" id="grp9">
                <cl:verticaldata std:sid="v-data-5ffb5f06" width="976px" height="40px" autosize="none"/>
                <cl:inputbox std:sid="i-box-8e42cad6" id="ipbPw" fieldLabel="New Password" secret="true" showclearbutton="false">
                  <cl:xylayoutdata std:sid="xyl-data-ee8632dd" top="0px" right="0px" bottom="0px" left="0px" horizontalAnchor="BOTH" verticalAnchor="BOTH"/>
                </cl:inputbox>
                <cl:checkbox std:sid="c-box-1f572ae3" id="cbxPwChk" class="chk-pw-toggle" value="true" falsevalue="false" text="">
                  <cl:listener std:sid="listener-0578512f" name="value-change" handler="onCbxPwChkValueChange"/>
                  <cl:xylayoutdata std:sid="xyl-data-982a909f" top="8px" right="12px" bottom="8px" width="20px" horizontalAnchor="RIGHT" verticalAnchor="BOTH"/>
                </cl:checkbox>
                <cl:xylayout std:sid="xylayout-2355ff8d" scrollable="false"/>
              </cl:group>
              <cl:verticallayout std:sid="v-layout-6b6413ac" spacing="6"/>
            </cl:group>
            <cl:group std:sid="group-24f7a73c" id="grp4">
              <cl:verticaldata std:sid="v-data-8a92e30e" width="976px" height="88px" syncminheight="false" autosize="both"/>
              <cl:output std:sid="output-bbccd994" id="opt3" class="label" value="Confirm Password">
                <cl:verticaldata std:sid="v-data-748b366e" width="100px" height="18px" autosize="height"/>
              </cl:output>
              <cl:group std:sid="group-0d9b2fad" id="grp8">
                <cl:verticaldata std:sid="v-data-c15d6467" width="976px" height="40px" autosize="none"/>
                <cl:inputbox std:sid="i-box-da85ec2d" id="ipbPw2" class="input-error" fieldLabel="Confirm Password" secret="true" showclearbutton="false">
                  <cl:xylayoutdata std:sid="xyl-data-4a59e6b2" top="0px" right="0px" bottom="0px" left="0px" horizontalAnchor="BOTH" verticalAnchor="BOTH"/>
                </cl:inputbox>
                <cl:checkbox std:sid="c-box-1baaa227" id="cbxPwChk2" class="chk-pw-toggle" value="true" falsevalue="false" text="">
                  <cl:listener std:sid="listener-c386e191" name="value-change" handler="onCbxPwChk2ValueChange"/>
                  <cl:xylayoutdata std:sid="xyl-data-ace71466" top="10px" right="12px" bottom="10px" width="20px" horizontalAnchor="RIGHT" verticalAnchor="BOTH"/>
                </cl:checkbox>
                <cl:xylayout std:sid="xylayout-e3017ee8" scrollable="false"/>
              </cl:group>
              <cl:output std:sid="output-64d82e99" id="opt5" class="font-caption error" value="Passwords do not match.">
                <cl:verticaldata std:sid="v-data-7fcf388c" width="976px" height="18px" autosize="both"/>
              </cl:output>
              <cl:verticallayout std:sid="v-layout-8ccc48a0" spacing="6"/>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-059c7adb" spacing="16"/>
          </cl:group>
          <cl:group std:sid="group-d719b5d1" id="grp6" class="req-box">
            <cl:verticaldata std:sid="v-data-77cdcf7f" width="976px" height="230px" autosize="height"/>
            <cl:output std:sid="output-43a77497" id="opt6" class="font-label fw-semibold" value="Password Requirements">
              <cl:verticaldata std:sid="v-data-1bc616a9" width="100px" height="20px"/>
            </cl:output>
            <cl:checkboxgroup std:sid="cb-group-c09b40ad" id="cbg1" class="font-body-s" fieldLabel="Password Length Requirement" colcount="1" hspacing="0">
              <cl:verticaldata std:sid="v-data-a423a131" width="816px" height="53px" autosize="both"/>
              <cl:item std:sid="item-bc1430c8" label="At least 8 characters" value="value1"/>
              <cl:item std:sid="item-3d8ab09f" label="At least 3 of the following character types" value="value2"/>
            </cl:checkboxgroup>
            <cl:checkboxgroup std:sid="cb-group-2c89923b" id="cbg2" style="padding-left:16px;" class="font-body-s" fieldLabel="&#x9;Password Character Type Requirements" colcount="1" hspacing="0">
              <cl:verticaldata std:sid="v-data-f8ebce01" width="200px" height="111px" autosize="both"/>
              <cl:item std:sid="item-13c009ee" label="Uppercase letter (A–Z)" value="value1"/>
              <cl:item std:sid="item-364c3012" label="Lowercase letter (a–z)" value="value2"/>
              <cl:item std:sid="item-8d94e860" label="Number (0–9)" value="value3"/>
              <cl:item std:sid="item-a537ca68" label="Special character (!@#$…)" value="value4"/>
            </cl:checkboxgroup>
            <cl:verticallayout std:sid="v-layout-d1644f78" spacing="8"/>
          </cl:group>
          <cl:verticallayout std:sid="v-layout-e8916d98" spacing="20"/>
        </cl:group>
        <cl:button std:sid="button-68fbe448" id="btn1" class="btn-primary" enabled="false" value="Complete Reset">
          <cl:verticaldata std:sid="v-data-5329bbe6" width="976px" height="40px" autosize="none"/>
        </cl:button>
        <cl:button std:sid="button-a522b411" id="btn2" class="btn-back" value="Back">
          <cl:listener std:sid="listener-039a37df" name="click" handler="onBtn2Click"/>
          <cl:verticaldata std:sid="v-data-2ca94808" width="976px" height="18px" autosize="height"/>
        </cl:button>
        <cl:verticallayout std:sid="v-layout-f0125bef" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-75ec9db6" spacing="0" leftmargin="32" rightmargin="32" topmargin="32" bottommargin="32"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-c56a26cf" scrollable="false" spacing="18"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
