  <body std:sid="body-fa5f6637" style="top:0px; left:0px; width:640px; height:520px;" class="auth">
    <cl:group std:sid="group-aeb301ea" id="grpBody">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-bottom-margin" value="16"/>
      <cl:attribute name="mobile-left-margin" value="16"/>
      <cl:attribute name="mobile-right-margin" value="16"/>
      <cl:attribute name="mobile-top-margin" value="16"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:verticaldata std:sid="v-data-f9431e1f" width="1024px" height="355px" autosize="height"/>
      <cl:group std:sid="group-9c6d43b3" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:attribute name="mobile-spacing" value="14"/>
        <cl:verticaldata std:sid="v-data-4109c237" width="976px" height="291px" autosize="height"/>
        <cl:group std:sid="group-4006bfd4" id="grp2" class="separate">
          <cl:verticaldata std:sid="v-data-75111c52" width="976px" height="193px" autosize="height"/>
          <cl:group std:sid="group-61a6e92c" id="grp3">
            <cl:verticaldata std:sid="v-data-8d47903c" width="976px" height="56px" autosize="both"/>
            <cl:output std:sid="output-5b5691f9" id="opt1" class="tit" value="PSE Management System">
              <cl:verticaldata std:sid="v-data-af7dbc36" width="100px" height="30px" autosize="both"/>
            </cl:output>
            <cl:output std:sid="output-0ce96798" id="opt2" class="sub-tit" value="Enter the code from Google Authenticator">
              <cl:verticaldata std:sid="v-data-77334901" width="100px" height="20px" autosize="height"/>
            </cl:output>
            <cl:verticallayout std:sid="v-layout-4775946b" spacing="6"/>
          </cl:group>
          <cl:output std:sid="output-29dd373d" id="opt3" class="font-body-s text-gray-70" value="Open Google Authenticator and enter the 6-digit code for pse.">
            <cl:verticaldata std:sid="v-data-fb773708" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:group std:sid="group-b5f4f056" id="grp1">
            <cl:verticaldata std:sid="v-data-110316be" width="976px" height="60px" autosize="height"/>
            <cl:output std:sid="output-373e0e8f" id="opt4" class="label" value="Authentication Code">
              <cl:verticaldata std:sid="v-data-49c25b03" width="100px" height="18px" autosize="height"/>
            </cl:output>
            <cl:inputbox std:sid="i-box-c811b69e" id="ipb1" fieldLabel="Authentication Code">
              <cl:verticaldata std:sid="v-data-bd8d8c4b" width="100px" height="36px"/>
            </cl:inputbox>
            <cl:verticallayout std:sid="v-layout-6b6413ac" spacing="6"/>
          </cl:group>
          <cl:verticallayout std:sid="v-layout-e8916d98" spacing="20"/>
        </cl:group>
        <cl:button std:sid="button-68fbe448" id="btn1" class="btn-primary" value="Verify">
          <cl:verticaldata std:sid="v-data-5329bbe6" width="100px" height="40px"/>
        </cl:button>
        <cl:button std:sid="button-a522b411" id="btn2" class="btn-back" value="Back to Log In">
          <cl:listener std:sid="listener-f6e97aa9" name="click" handler="onBtn2Click"/>
          <cl:verticaldata std:sid="v-data-2ca94808" width="100px" height="18px" autosize="height"/>
        </cl:button>
        <cl:verticallayout std:sid="v-layout-f0125bef" scrollable="false" spacing="20"/>
      </cl:group>
