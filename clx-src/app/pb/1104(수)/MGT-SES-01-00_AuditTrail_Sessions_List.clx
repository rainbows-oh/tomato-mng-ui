            <cl:gridcell std:sid="gd-cell-00000121" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-0000011e" rowindex="0" colindex="1" columnname="username">
              <cl:button std:sid="button-0000011f" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="username"/>
                <cl:celldata std:sid="c-data-00000120"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000122" rowindex="0" colindex="2" columnname="company">
              <cl:output std:sid="output-00000123">
                <cl:expbind property="value" category="PROPERTY" expression="company"/>
                <cl:celldata std:sid="c-data-00000124"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000125" rowindex="0" colindex="3" columnname="system">
              <cl:output std:sid="output-00000126" class="badge" displayexp="sstr(text, switch(system){&#xD;&#xA;&#x9;case &quot;Management&quot; : &quot;badge fill green&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="system"/>
                <cl:expbind property="class" category="CLASS" expression="system == &quot;Management&quot; ? &quot;&quot; : &quot;fill blue&quot;"/>
                <cl:celldata std:sid="c-data-00000127"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000128" rowindex="0" colindex="4" columnname="status">
              <cl:output std:sid="output-00000129" displayexp="sstr(text, [&quot;badge fill blue&quot;])">
                <cl:expbind property="value" category="PROPERTY" expression="status"/>
                <cl:celldata std:sid="c-data-0000012a"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000012b" rowindex="0" colindex="5" columnname="loginAt">
              <cl:output std:sid="output-0000012c" datatype="date" format="YYYY-MM-DD HH:mm:ss">
                <cl:expbind property="value" category="PROPERTY" expression="loginAt"/>
                <cl:celldata std:sid="c-data-0000012d"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000012e" rowindex="0" colindex="6" columnname="lastActivity">
              <cl:output std:sid="output-0000012f" datatype="date" format="YYYY-MM-DD HH:mm:ss">
                <cl:expbind property="value" category="PROPERTY" expression="lastActivity"/>
                <cl:celldata std:sid="c-data-00000130"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:udc std:sid="ud-control-eaa7f396" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-98b2d615" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-40e46285" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-fc7fc5a9" scrollable="false" spacing="20" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-3c32ff37" scrollable="true" spacing="0"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>