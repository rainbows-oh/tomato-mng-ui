          <cl:output std:sid="output-3ac2ed84" class="sch-info" value="20" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; login attempts&quot;">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:formdata std:sid="f-data-c4b6fe60" row="0" col="0"/>
          </cl:output>
          <cl:group std:sid="group-5c3d9eb9">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:formdata std:sid="f-data-15a35e88" row="0" col="1"/>
            <cl:button std:sid="button-d5b375b3" class="btn-inline btn-file" value="Excel Download" icon="0">
              <cl:flowlayoutdata std:sid="f-data-cef36371" width="133px" height="36px" autosize="width"/>
            </cl:button>
            <cl:combobox std:sid="c-box-d195aaaa" fieldLabel="Rows per page" value="15">
              <cl:flowlayoutdata std:sid="f-data-9b5dca83" width="110px" height="36px"/>
              <cl:item std:sid="t-item-sa000201" label="15/page" value="15"/>
            </cl:combobox>
            <cl:flowlayout std:sid="f-layout-3ac577df" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-da312581" scrollable="false" hspace="1fr" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="422" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-25fbe45e" fieldLabel="User Log list" datasetid="dsList" autofit="1, 2, 3, 4, 5, 6" resizablecolumns="1, 2, 3, 4, 5, 6" columnMovable="true">
          <cl:verticaldata std:sid="v-data-6b21a1a8" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-00000148" width="80px"/>
          <cl:gridcolumn std:sid="g-column-00000149" width="200px"/>
          <cl:gridcolumn std:sid="g-column-0000014a" width="330px"/>
          <cl:gridcolumn std:sid="g-column-0000014b" width="180px"/>
          <cl:gridcolumn std:sid="g-column-0000014c" width="160px"/>
          <cl:gridcolumn std:sid="g-column-0000014d" width="260px"/>
          <cl:gridcolumn std:sid="g-column-0000014e" width="260px"/>
          <cl:gridheader std:sid="gh-band-d28a541f">
            <cl:gridrow std:sid="g-row-d576d7a2" height="37px"/>
            <cl:gridcell std:sid="gh-cell-0000014f" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No."/>
            <cl:gridcell std:sid="gh-cell-00000150" rowindex="0" colindex="1" targetcolumnname="username" sortable="true" filterable="false" text="Username"/>
            <cl:gridcell std:sid="gh-cell-00000151" rowindex="0" colindex="2" targetcolumnname="companyName" sortable="true" filterable="false" text="Company Name"/>
            <cl:gridcell std:sid="gh-cell-00000152" rowindex="0" colindex="3" targetcolumnname="system" sortable="true" filterable="false" text="System"/>
            <cl:gridcell std:sid="gh-cell-00000153" rowindex="0" colindex="4" targetcolumnname="result" sortable="true" filterable="false" text="Result"/>
            <cl:gridcell std:sid="gh-cell-00000154" rowindex="0" colindex="5" targetcolumnname="loginAt" sortable="true" filterable="false" text="Attempt/Login Time"/>
            <cl:gridcell std:sid="gh-cell-00000155" rowindex="0" colindex="6" targetcolumnname="logoutAt" sortable="true" filterable="false" text="Logout Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-93b884d1">
            <cl:gridrow std:sid="g-row-8d12379b" height="54px"/>
            <cl:gridcell std:sid="gd-cell-0000013b" rowindex="0" colindex="0" columntype="rowindex"/>
            <cl:gridcell std:sid="gd-cell-0000013c" rowindex="0" colindex="1" columnname="username">
              <cl:button std:sid="button-0000013d" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="username"/>
                <cl:celldata std:sid="c-data-0000013e"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000013f" rowindex="0" colindex="2" columnname="companyName">
              <cl:button std:sid="button-00000140" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="companyName"/>
                <cl:celldata std:sid="c-data-00000141"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000135" rowindex="0" colindex="3" columnname="system">
              <cl:output std:sid="output-00000136" class="badge" displayexp="sstr(text, switch(system){&#xD;&#xA;&#x9;case &quot;Management&quot; : &quot;badge fill green&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="system"/>
                <cl:expbind property="class" category="CLASS" expression="system == &quot;Management&quot; ? &quot;fill blue&quot; : &quot;&quot;"/>
                <cl:celldata std:sid="c-data-00000137"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000138" rowindex="0" colindex="4" columnname="result">
              <cl:output std:sid="output-00000139" class="badge fill" displayexp="sstr(text, switch(result){&#xD;&#xA;&#x9;case &quot;Failed&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="result"/>
                <cl:expbind property="class" category="CLASS" expression="(result == &quot;Failed&quot;) ? &quot;red&quot; : &quot;blue&quot;"/>
                <cl:celldata std:sid="c-data-0000013a"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000142" rowindex="0" colindex="5" columnname="loginAt">
              <cl:output std:sid="output-00000143" datatype="date" format="MM-DD-YYYY hh:mm:ss A" displayexp="text ? text : &quot;—&quot;">
                <cl:expbind property="value" category="PROPERTY" expression="loginAt"/>
                <cl:celldata std:sid="c-data-00000144"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00000145" rowindex="0" colindex="6" columnname="logoutAt">
              <cl:output std:sid="output-00000146" datatype="date" format="MM-DD-YYYY hh:mm:ss A" displayexp="text ? text : &quot;—&quot;">
                <cl:expbind property="value" category="PROPERTY" expression="logoutAt"/>
                <cl:celldata std:sid="c-data-00000147"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:udc std:sid="ud-control-eaa7f396" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-98b2d615" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-40e46285" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-fc7fc5a9" scrollable="false" spacing="20" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-3c32ff37" scrollable="true" spacing="0"/>
  </body>
