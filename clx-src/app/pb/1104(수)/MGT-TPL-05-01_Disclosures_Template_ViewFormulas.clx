          <cl:gridcolumn std:sid="g-column-266480ae" width="330px"/>
          <cl:gridcolumn std:sid="g-column-ffb72cb3" width="160px"/>
          <cl:gridcolumn std:sid="g-column-bd47607b" width="330px"/>
          <cl:gridcolumn std:sid="g-column-4d7cf73e" width="90px"/>
          <cl:gridcolumn std:sid="g-column-22bf931d" width="60px"/>
          <cl:gridheader std:sid="gh-band-d75ba979">
            <cl:gridrow std:sid="g-row-1464d57d" height="37px"/>
            <cl:gridcell std:sid="gh-cell-bf445e19" rowindex="0" colindex="0" targetcolumnname="outputField" sortable="false" filterable="false" text="Output Field"/>
            <cl:gridcell std:sid="gh-cell-2f0b8152" rowindex="0" colindex="1" targetcolumnname="classification" sortable="false" filterable="false" text="Classification"/>
            <cl:gridcell std:sid="gh-cell-4d4bc856" rowindex="0" colindex="2" targetcolumnname="formulaText" sortable="false" filterable="false" text="Formula"/>
            <cl:gridcell std:sid="gh-cell-16a88b77" rowindex="0" colindex="3" rowspan="1" colspan="2" sortable="false" filterable="false" text="Actions"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-5a0406b7">
            <cl:gridrow std:sid="g-row-ea7dccdd" height="54px"/>
            <cl:gridcell std:sid="gd-cell-b8cbfce3" rowindex="0" colindex="0" columnname="outputField">
              <cl:output std:sid="output-ec1e080f">
                <cl:expbind property="value" category="PROPERTY" expression="outputField"/>
                <cl:celldata std:sid="c-data-f7349a5f"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-ddd4c048" rowindex="0" colindex="1" columnname="classification">
              <cl:output std:sid="output-a9a1f92b">
                <cl:expbind property="value" category="PROPERTY" expression="classification"/>
                <cl:celldata std:sid="c-data-78d28658"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-8a6387ba" rowindex="0" colindex="2" columnname="formulaText">
              <cl:output std:sid="output-62a59f95">
                <cl:expbind property="value" category="PROPERTY" expression="formulaText"/>
                <cl:celldata std:sid="c-data-634d7dc9"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-80e5920e" rowindex="0" colindex="3" columnname="editBtn">
              <cl:button std:sid="button-98e9a65c" id="btn2" class="btn-inline" fieldLabel="open edit" value="Edit">
                <cl:expbind property="value" category="PROPERTY" expression="editBtn"/>
                <cl:celldata std:sid="c-data-4e9d682f" halign="FILL" valign="CENTER" width="68" height="36"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-47e082aa" rowindex="0" colindex="4" columnname="deleteBtn">
              <cl:button std:sid="button-425b2e7c" id="btn1" class="btn-delete icon" fieldLabel="delete row" value="Button" icon="0">
                <cl:expbind property="value" category="PROPERTY" expression="deleteBtn"/>
                <cl:celldata std:sid="c-data-a4c09af9" halign="CENTER" valign="CENTER" width="28" height="28"/>
              </cl:button>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:verticallayout std:sid="v-layout-f0125bef" scrollable="false" spacing="16"/>
