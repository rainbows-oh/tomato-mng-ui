    <screen std:sid="screen-1c425079" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f3abc1ae" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-f0487b32" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-f5dd3c0f">
      <cl:dataset std:sid="d-set-17208331" id="dsList">
        <cl:datacolumnlist>
          <cl:datacolumn std:sid="d-column-fce5e9d7" name="outputField"/>
          <cl:datacolumn std:sid="d-column-f35cb8a9" name="classification"/>
          <cl:datacolumn std:sid="d-column-323d3ab0" name="formulaText"/>
          <cl:datacolumn std:sid="d-column-cc92d33d" name="editBtn"/>
          <cl:datacolumn std:sid="d-column-40b2d002" name="deleteBtn"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="outputField"><![CDATA[Balance Sheet — Total Assets (Year Ending)]]></cl:datavalue>
            <cl:datavalue columnname="classification"><![CDATA[Custom Formula]]></cl:datavalue>
            <cl:datavalue columnname="formulaText"><![CDATA[( [Current Liabilities] ÷ [Total Liabilities] )]]></cl:datavalue>
            <cl:datavalue columnname="editBtn"><![CDATA[Edit]]></cl:datavalue>
            <cl:datavalue columnname="deleteBtn"><![CDATA[Delete]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="outputField"><![CDATA[Income Statement — Gross Expense (Year Ending)]]></cl:datavalue>
            <cl:datavalue columnname="classification"><![CDATA[Custom Formula]]></cl:datavalue>
            <cl:datavalue columnname="formulaText"><![CDATA[[Total Assets] × ( [Total Assets] ÷ [Current Liabilities] )]]></cl:datavalue>
            <cl:datavalue columnname="editBtn"><![CDATA[Edit]]></cl:datavalue>
            <cl:datavalue columnname="deleteBtn"><![CDATA[Delete]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="All Formulas"/>
  </head>
  <body std:sid="body-fa5f6637" style="top:0px; left:0px; width:640px; height:520px;">
    <cl:group std:sid="group-aeb301ea" id="grpBody">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-bottom-margin" value="16"/>
      <cl:attribute name="mobile-left-margin" value="16"/>
      <cl:attribute name="mobile-right-margin" value="16"/>
      <cl:attribute name="mobile-top-margin" value="16"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:verticaldata std:sid="v-data-f9431e1f" width="1024px" height="401px" autosize="height"/>
      <cl:group std:sid="group-80bc9b0f" id="grpContentHeader">
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:attribute name="mobile-spacing" value="14"/>
        <cl:verticaldata std:sid="v-data-f3021694" width="976px" height="20px" autosize="height"/>
        <cl:group std:sid="group-4cbd26ca">
          <cl:verticaldata std:sid="v-data-7aba902b" width="976px" height="20px" autosize="height"/>
          <cl:output std:sid="output-53a3635d" class="font-body-s gray" value="Review, edit, or delete formulas configured on this template.">
            <cl:flowlayoutdata std:sid="f-data-cea226cb" width="549px" height="20px" autosize="both"/>
          </cl:output>
          <cl:flowlayout std:sid="f-layout-93080131" hspacing="0" valign="middle"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-d479a373" spacing="16"/>
      </cl:group>
      <cl:group std:sid="group-9c6d43b3" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:attribute name="mobile-spacing" value="14"/>
        <cl:verticaldata std:sid="v-data-4109c237" width="976px" height="236px" autosize="height"/>
        <cl:output std:sid="output-ff0f3a14" id="opt1" class="font-body text-gray-50" value="No formulas configured yet. Use an fx button on a value cell to add one.">
          <cl:verticaldata std:sid="v-data-9dcab9d0" width="100px" height="20px" autosize="height"/>
        </cl:output>
        <cl:grid std:sid="grid-c0458e8c" id="grd1" fieldLabel="Formulas" datasetid="dsList" autofit="0, 1, 2">
