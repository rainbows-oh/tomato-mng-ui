        <cl:grid std:sid="grid-25fbe45e" fieldLabel="Batch list" datasetid="dsList" autofit="1, 2, 3, 4, 5, 6" resizablecolumns="1, 2, 3, 4, 5, 6" columnMovable="true">
          <cl:verticaldata std:sid="v-data-6b21a1a8" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-00000126" width="80px"/>
