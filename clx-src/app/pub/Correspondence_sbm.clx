            <cl:verticaldata std:sid="v-data-csm000038" width="926px" height="206px" autosize="height"/>
            <cl:group std:sid="group-csm000039" class="row">
              <cl:attribute name="mobile-column-count" value="1"/>
              <cl:verticaldata std:sid="v-data-csm000040" width="926px" height="58px" autosize="height"/>
              <cl:group std:sid="group-csm000041">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-csm000042" row="0" col="0"/>
                <cl:output std:sid="output-csm000043" class="label" value="Classification">
                  <cl:verticaldata std:sid="v-data-csm000044" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:combobox std:sid="c-box-csm000045" fieldLabel="Classification">
                  <cl:verticaldata std:sid="v-data-csm000046" width="110px" height="32px" autosize="none"/>
                </cl:combobox>
                <cl:verticallayout std:sid="v-layout-csm000047"/>
              </cl:group>
              <cl:group std:sid="group-csm000048">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-dd5ef920" row="0" col="1"/>
                <cl:output std:sid="output-csm000050" class="label" value="Reply Status">
                  <cl:verticaldata std:sid="v-data-csm000051" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:checkboxgroup std:sid="cb-group-csm000052" fieldLabel="Reply Status">
                  <cl:verticaldata std:sid="v-data-csm000053" width="200px" height="32px"/>
                  <cl:item std:sid="item-csm000054" label="Open" value="value1"/>
                  <cl:item std:sid="item-csm000055" label="Closed" value="value2"/>
                </cl:checkboxgroup>
                <cl:verticallayout std:sid="v-layout-csm000056"/>
              </cl:group>
              <cl:formlayout std:sid="f-layout-csm000057" scrollable="false" hspace="12px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                <cl:rows length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION" minlength="0"/>
              </cl:formlayout>
            </cl:group>
            <cl:group std:sid="group-csm000058" class="row">
              <cl:attribute name="mobile-column-count" value="1"/>
              <cl:verticaldata std:sid="v-data-csm000059" width="926px" height="58px" autosize="height"/>
              <cl:group std:sid="group-csm000060">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-csm000061" row="0" col="0"/>
                <cl:output std:sid="output-csm000062" class="label" value="Period">
                  <cl:verticaldata std:sid="v-data-csm000063" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:group std:sid="group-csm000064" class="input-group">
                  <cl:attribute name="mobile-column-count" value="1"/>
                  <cl:verticaldata std:sid="v-data-csm000065" width="457px" height="32px" autosize="height"/>
                  <cl:group std:sid="group-csm000066">
                    <cl:formdata std:sid="f-data-csm000067" row="0" col="0" rowspan="1" colspan="1"/>
                    <cl:dateinput std:sid="d-input-csm000068" fieldLabel="Period start" hidebutton="true" placeholder="MM-DD-YYYY">
                      <cl:formdata std:sid="f-data-csm000069" row="0" col="0"/>
                    </cl:dateinput>
                    <cl:output std:sid="output-csm000070" value="~">
                      <cl:formdata std:sid="f-data-csm000071" row="0" col="1"/>
                    </cl:output>
                    <cl:dateinput std:sid="d-input-csm000072" fieldLabel="Period end" hidebutton="true" placeholder="MM-DD-YYYY">
                      <cl:formdata std:sid="f-data-csm000073" row="0" col="2"/>
                    </cl:dateinput>
                    <cl:formlayout std:sid="f-layout-csm000074" scrollable="false" hspace="8px" vspace="8px">
                      <cl:rows length="32" unit="PIXEL"/>
                      <cl:columns length="1" unit="FRACTION"/>
                      <cl:columns length="10" unit="PIXEL" autoSizing="true" syncminlength="false"/>
                      <cl:columns length="1" unit="FRACTION"/>
                    </cl:formlayout>
                  </cl:group>
                  <cl:combobox std:sid="c-box-csm000075" fieldLabel="Select period">
                    <cl:formdata std:sid="f-data-csm000076" row="0" col="1"/>
                  </cl:combobox>
                  <cl:formlayout std:sid="f-layout-csm000077" scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                    <cl:rows length="32" unit="PIXEL"/>
                    <cl:columns length="274" unit="PIXEL"/>
                    <cl:columns length="1" unit="FRACTION"/>
                  </cl:formlayout>
                </cl:group>
                <cl:verticallayout std:sid="v-layout-csm000078"/>
              </cl:group>
              <cl:group std:sid="group-csm000079">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-csm000080" row="0" col="1"/>
                <cl:output std:sid="output-csm000081" class="label" value="Deadline">
                  <cl:verticaldata std:sid="v-data-csm000082" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:group std:sid="group-csm000083" class="input-group">
                  <cl:attribute name="mobile-column-count" value="1"/>
                  <cl:verticaldata std:sid="v-data-csm000084" width="457px" height="32px" autosize="height"/>
                  <cl:group std:sid="group-csm000085">
                    <cl:formdata std:sid="f-data-csm000086" row="0" col="0" rowspan="1" colspan="1"/>
                    <cl:dateinput std:sid="d-input-csm000087" fieldLabel="Deadline start" hidebutton="true" placeholder="MM-DD-YYYY">
                      <cl:formdata std:sid="f-data-csm000088" row="0" col="0"/>
                    </cl:dateinput>
                    <cl:output std:sid="output-csm000089" value="~">
                      <cl:formdata std:sid="f-data-csm000090" row="0" col="1"/>
                    </cl:output>
                    <cl:dateinput std:sid="d-input-csm000091" fieldLabel="Deadline end" hidebutton="true" placeholder="MM-DD-YYYY">
                      <cl:formdata std:sid="f-data-csm000092" row="0" col="2"/>
                    </cl:dateinput>
                    <cl:formlayout std:sid="f-layout-csm000093" scrollable="false" hspace="8px" vspace="8px">
                      <cl:rows length="32" unit="PIXEL"/>
                      <cl:columns length="1" unit="FRACTION"/>
                      <cl:columns length="10" unit="PIXEL" autoSizing="true" syncminlength="false"/>
                      <cl:columns length="1" unit="FRACTION"/>
                    </cl:formlayout>
                  </cl:group>
                  <cl:combobox std:sid="c-box-csm000094" fieldLabel="Select period">
                    <cl:formdata std:sid="f-data-csm000095" row="0" col="1"/>
                  </cl:combobox>
                  <cl:formlayout std:sid="f-layout-csm000096" scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                    <cl:rows length="32" unit="PIXEL"/>
                    <cl:columns length="274" unit="PIXEL"/>
                    <cl:columns length="1" unit="FRACTION"/>
                  </cl:formlayout>
                </cl:group>
                <cl:verticallayout std:sid="v-layout-csm000097"/>
              </cl:group>
              <cl:formlayout std:sid="f-layout-csm000098" scrollable="false" hspace="12px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                <cl:rows length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION" minlength="0"/>
              </cl:formlayout>
            </cl:group>
            <cl:group std:sid="group-csm000099" class="row">
              <cl:attribute name="mobile-column-count" value="1"/>
              <cl:verticaldata std:sid="v-data-csm000100" width="926px" height="58px" autosize="height"/>
              <cl:group std:sid="group-csm000101">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-csm000102" row="0" col="0"/>
                <cl:output std:sid="output-csm000103" class="label" value="Subject">
                  <cl:verticaldata std:sid="v-data-csm000104" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:inputbox std:sid="i-box-csm000105" fieldLabel="Subject" placeholder="Search by subject">
                  <cl:verticaldata std:sid="v-data-csm000106" width="100px" height="32px"/>
                </cl:inputbox>
                <cl:verticallayout std:sid="v-layout-csm000107"/>
              </cl:group>
              <cl:group std:sid="group-csm000108">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-csm000109" row="0" col="1"/>
                <cl:output std:sid="output-csm000110" class="label" value="Keyword">
                  <cl:verticaldata std:sid="v-data-csm000111" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:inputbox std:sid="i-box-csm000112" fieldLabel="Keyword" placeholder="Search by keyword">
                  <cl:verticaldata std:sid="v-data-csm000113" width="457px" height="32px" autosize="none"/>
                </cl:inputbox>
                <cl:verticallayout std:sid="v-layout-csm000114"/>
              </cl:group>
              <cl:formlayout std:sid="f-layout-csm000115" scrollable="false" hspace="12px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                <cl:rows length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION" minlength="0"/>
              </cl:formlayout>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-csm000116" scrollable="false" spacing="16"/>
          </cl:group>
          <cl:group std:sid="group-csm000117" class="search-btn-wrap">
            <cl:verticaldata std:sid="v-data-csm000118" width="400px" height="49px" autosize="height"/>
            <cl:button std:sid="button-csm000119" class="btn-base" value="Clear">
              <cl:flowlayoutdata std:sid="f-data-csm000120" width="69px" height="32px" autosize="width"/>
            </cl:button>
            <cl:button std:sid="button-csm000121" class="btn-search" value="Search" icon="0">
              <cl:flowlayoutdata std:sid="f-data-csm000122" width="104px" height="32px" autosize="width"/>
            </cl:button>
            <cl:flowlayout std:sid="f-layout-csm000123" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
          </cl:group>
          <cl:verticallayout std:sid="v-layout-csm000124" scrollable="false" spacing="16" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-csm000125" scrollable="false" spacing="0"/>
      </cl:group>
      <cl:group std:sid="group-csm000126" class="section">
        <cl:verticaldata std:sid="v-data-csm000127" width="400px" height="686px" autosize="height"/>
        <cl:group std:sid="group-csm000128" class="search-list-top">
          <cl:verticaldata std:sid="v-data-csm000129" width="400px" height="64px" autosize="height"/>
          <cl:output std:sid="output-csm000130" class="sch-info" value="12" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; correspondence items&quot;">
            <cl:formdata std:sid="f-data-csm000131" row="0" col="0"/>
          </cl:output>
          <cl:group std:sid="group-csm000132">
            <cl:formdata std:sid="f-data-csm000133" row="0" col="1"/>
            <cl:udc std:sid="ud-control-csm000134" id="udccomviewbutton1" type="udc.pse.com.UdcComViewButton">
              <cl:flowlayoutdata std:sid="f-data-csm000135" width="68px" height="32px" autosize="both"/>
            </cl:udc>
            <cl:flowlayout std:sid="f-layout-csm000136" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-csm000137" scrollable="false" hspace="1fr" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="68" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-csm000138" datasetid="dsList" autofit="1, 2, 3, 4" resizablecolumns="all" columnMovable="true">
          <cl:verticaldata std:sid="v-data-csm000139" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-csm000140" width="56px"/>
          <cl:gridcolumn std:sid="g-column-csm000141" width="420px"/>
          <cl:gridcolumn std:sid="g-column-csm000142" width="200px"/>
          <cl:gridcolumn std:sid="g-column-csm000143" width="140px"/>
          <cl:gridcolumn std:sid="g-column-csm000144" width="190px"/>
          <cl:gridheader std:sid="gh-band-csm000145">
            <cl:gridrow std:sid="g-row-csm000146" height="32px"/>
            <cl:gridcell std:sid="gh-cell-csm000147" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No"/>
            <cl:gridcell std:sid="gh-cell-csm000148" rowindex="0" colindex="1" targetcolumnname="subject" sortable="false" filterable="false" text="Subject"/>
            <cl:gridcell std:sid="gh-cell-csm000149" rowindex="0" colindex="2" targetcolumnname="from" sortable="false" filterable="false" text="From"/>
            <cl:gridcell std:sid="gh-cell-csm000150" rowindex="0" colindex="3" targetcolumnname="replyStatus" sortable="false" filterable="false" text="Reply Status"/>
            <cl:gridcell std:sid="gh-cell-csm000151" rowindex="0" colindex="4" targetcolumnname="date" sortable="false" filterable="false" text="Date and Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-csm000152">
            <cl:gridrow std:sid="g-row-csm000153" height="50px"/>
            <cl:gridcell std:sid="gd-cell-csm000154" rowindex="0" colindex="0" columnname="no">
              <cl:output std:sid="output-csm000155">
                <cl:celldata std:sid="c-data-csm000156"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-csm000157" rowindex="0" colindex="1" columnname="subject">
              <cl:button std:sid="button-csm000158" class="btn-row-height" value="Button" displayexp="switch(urgent){case &quot;1&quot; : subject + sstr(badge, [&quot;btn-grid-badge-red&quot;]) case &quot;&quot; : subject default : subject + sstr(badge, [&quot;btn-grid-badge-gray&quot;])}">
                <cl:celldata std:sid="c-data-csm000159"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-csm000160" rowindex="0" colindex="2" columnname="from">
              <cl:output std:sid="output-csm000161">
                <cl:celldata std:sid="c-data-csm000162"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-csm000163" rowindex="0" colindex="3" columnname="replyStatus">
              <cl:output std:sid="output-csm000164" displayexp="sstr(switch(replyStatus){case &quot;open&quot; : &quot;Open&quot; case &quot;closed&quot; : &quot;Closed&quot; default : &quot;-&quot;}, switch(replyStatus){case &quot;open&quot; : &quot;badge soft warning&quot; case &quot;closed&quot; : &quot;badge soft success&quot; default : &quot;&quot;})">
                <cl:celldata std:sid="c-data-csm000165"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-csm000166" rowindex="0" colindex="4" columnname="date">
              <cl:output std:sid="output-csm000167" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:celldata std:sid="c-data-csm000168"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:udc std:sid="ud-control-csm000169" id="udccompagination1" type="udc.pse.com.UdcComPagination">
          <cl:verticaldata std:sid="v-data-csm000170" width="1024px" height="60px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-csm000171" scrollable="false" spacing="0"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-csm000172" scrollable="false" spacing="16" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-csm000173" scrollable="true" spacing="0"/>
  </body>
