<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-csm000001" version="1.0.6190">
  <head std:sid="head-csm000002">
    <screen std:sid="screen-csm000003" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-csm000004" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-csm000005" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-csm000006">
      <cl:dataset std:sid="d-set-csm000007" id="dsList">
        <cl:datacolumnlist>
          <cl:datacolumn comment="No" std:sid="d-column-csm000008" name="no"/>
          <cl:datacolumn comment="Subject" std:sid="d-column-csm000009" name="subject"/>
          <cl:datacolumn comment="From" std:sid="d-column-csm000010" name="from"/>
          <cl:datacolumn comment="Reply Status" std:sid="d-column-csm000011" name="replyStatus"/>
          <cl:datacolumn comment="Date and Time" std:sid="d-column-csm000012" name="date"/>
          <cl:datacolumn comment="Urgent" std:sid="d-column-csm000013" name="urgent"/>
          <cl:datacolumn comment="Badge" std:sid="d-column-csm000014" name="badge"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="no"><![CDATA[1]]></cl:datavalue>
            <cl:datavalue columnname="subject"><![CDATA[Please review the updated disclosure submission requirements. Please review the updated disclosure submission requirements.]]></cl:datavalue>
            <cl:datavalue columnname="from"><![CDATA[Listings & Disclosure]]></cl:datavalue>
            <cl:datavalue columnname="replyStatus"><![CDATA[open]]></cl:datavalue>
            <cl:datavalue columnname="date"><![CDATA[08252026011429]]></cl:datavalue>
            <cl:datavalue columnname="urgent"><![CDATA[1]]></cl:datavalue>
            <cl:datavalue columnname="badge"><![CDATA[1]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="no"><![CDATA[2]]></cl:datavalue>
            <cl:datavalue columnname="subject"><![CDATA[Additional information is required for the submitted report.]]></cl:datavalue>
            <cl:datavalue columnname="from"><![CDATA[Disclosure Department]]></cl:datavalue>
            <cl:datavalue columnname="replyStatus"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="date"><![CDATA[08252026011429]]></cl:datavalue>
            <cl:datavalue columnname="urgent"><![CDATA[0]]></cl:datavalue>
            <cl:datavalue columnname="badge"><![CDATA[4]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="no"><![CDATA[3]]></cl:datavalue>
            <cl:datavalue columnname="subject"><![CDATA[Your filing has been received and is now under review.]]></cl:datavalue>
            <cl:datavalue columnname="from"><![CDATA[Market Surveillance]]></cl:datavalue>
            <cl:datavalue columnname="replyStatus"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="date"><![CDATA[08252026011429]]></cl:datavalue>
            <cl:datavalue columnname="urgent"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="badge"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="no"><![CDATA[4]]></cl:datavalue>
            <cl:datavalue columnname="subject"><![CDATA[A reply has been added to your inquiry.]]></cl:datavalue>
            <cl:datavalue columnname="from"><![CDATA[Listings & Disclosure]]></cl:datavalue>
            <cl:datavalue columnname="replyStatus"><![CDATA[closed]]></cl:datavalue>
            <cl:datavalue columnname="date"><![CDATA[08252026011429]]></cl:datavalue>
            <cl:datavalue columnname="urgent"><![CDATA[0]]></cl:datavalue>
            <cl:datavalue columnname="badge"><![CDATA[2]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec/>
  </head>
  <body std:sid="body-csm000015">
    <cl:group std:sid="group-csm000016" class="page-title-wrap">
      <cl:verticaldata std:sid="v-data-csm000017" width="1024px" height="56px" autosize="height" sticky="true" stickytopoffset="0"/>
      <cl:udc std:sid="ud-control-csm000018" id="udccomappheader1" type="udc.pse.com.UdcComAppHeader">
        <cl:formdata std:sid="f-data-csm000019" row="0" col="0"/>
        <cl:property name="title" value="Correspondence" type="string"/>
      </cl:udc>
      <cl:group std:sid="group-csm000020" class="btn-wrap">
        <cl:formdata std:sid="f-data-csm000021" valign="FILL" height="32" row="0" col="1"/>
        <cl:flowlayout std:sid="f-layout-csm000022" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
      </cl:group>
      <cl:formlayout std:sid="f-layout-csm000023" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="1" unit="FRACTION"/>
        <cl:columns length="1" unit="FRACTION"/>
        <cl:columns length="136" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      </cl:formlayout>
    </cl:group>
    <cl:group std:sid="group-csm000024" id="grpBody" class="inner">
      <cl:verticaldata std:sid="v-data-csm000025" width="1024px" height="1149px" autosize="height"/>
      <cl:group std:sid="group-csm000026" class="search-top-box active">
        <cl:verticaldata std:sid="v-data-csm000027" width="976px" height="399px" autosize="height"/>
        <cl:group std:sid="group-csm000028" class="search-head">
          <cl:verticaldata std:sid="v-data-csm000029" width="974px" height="78px" autosize="height"/>
          <cl:udc std:sid="ud-control-csm000030" id="udccomsearchtoggle1" type="udc.pse.com.udcComSearchToggle">
            <cl:verticaldata std:sid="v-data-csm000031" width="942px" height="24px" autosize="height"/>
            <cl:property name="optMsg" value="optMessage" type="control"/>
            <cl:property name="grpId" value="grpSearchFilter" type="control"/>
            <cl:property name="targetOutput" value="optMessage" type="control"/>
            <cl:property name="targetGroup" value="grpSearchFilter" type="control"/>
