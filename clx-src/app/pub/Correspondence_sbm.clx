          <cl:verticallayout std:sid="v-layout-csm000034" scrollable="false" spacing="4"/>
        </cl:group>
        <cl:group std:sid="group-csm000035" id="grpSearchFilter" class="sch-filter-box">
          <cl:verticaldata std:sid="v-data-csm000036" width="974px" height="319px" autosize="height"/>
